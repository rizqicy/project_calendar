VERSION 5.7 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;

MANUFACTURINGGRID    0.005000 ;

SITE core_hd
    SYMMETRY Y  ;
    CLASS CORE  ;
    SIZE 0.560 BY 4.480 ;
END core_hd

SITE core_hd_dh
    SYMMETRY Y  ;
    CLASS CORE  ;
    SIZE 0.560 BY 8.960 ;
END core_hd_dh

MACRO AN211HDX0
  CLASS CORE ;
  ORIGIN 0 0 ;
  FOREIGN AN211HDX0 0 0 ;
  SIZE 3.36 BY 4.48 ;
  SYMMETRY X Y ;
  SITE core_hd ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAMODEL OXIDE1 ;
      ANTENNAGATEAREA 0.2052 LAYER MET1 ;
    PORT
      LAYER MET1 ;
        RECT 0.7 1.77 1.5 2.15 ;
    END
  END A
  PIN B
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAMODEL OXIDE1 ;
      ANTENNAGATEAREA 0.2052 LAYER MET1 ;
    PORT
      LAYER MET1 ;
        POLYGON 0.47 2.13 0.14 2.13 0.14 1.23 0.42 1.23 0.42 1.79 0.47 1.79 ;
    END
  END B
  PIN vdd
    DIRECTION INOUT ;
    USE POWER ;
    SHAPE ABUTMENT ;
    NETEXPR "power_vdd vdd!" ;
    PORT
      LAYER MET1 ;
        RECT 0 4.08 3.36 4.88 ;
        RECT 0.69 3.63 1.03 4.08 ;
    END
  END vdd
  PIN Q
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    ANTENNADIFFAREA 0.774 LAYER MET1 ;
    PORT
      LAYER MET1 ;
        POLYGON 3.22 3.22 2.89 3.22 2.89 2.88 2.94 2.88 2.94 1.54 1.25 1.54 1.25 1.21 3.22 1.21 ;
    END
  END Q
  PIN C
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAMODEL OXIDE1 ;
      ANTENNAGATEAREA 0.2052 LAYER MET1 ;
    PORT
      LAYER MET1 ;
        RECT 1.82 1.77 2.62 2.15 ;
    END
  END C
  PIN D
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAMODEL OXIDE1 ;
      ANTENNAGATEAREA 0.2052 LAYER MET1 ;
    PORT
      LAYER MET1 ;
        RECT 2.38 3.45 3.18 3.83 ;
    END
  END D
  PIN gnd
    DIRECTION INOUT ;
    USE GROUND ;
    SHAPE ABUTMENT ;
    NETEXPR "ground_gnd gnd!" ;
    PORT
      LAYER MET1 ;
        RECT 0.18 0.4 0.47 0.76 ;
        RECT 0 -0.4 3.36 0.4 ;
        RECT 2.38 0.4 2.66 0.76 ;
    END
  END gnd
  OBS
    LAYER MET1 ;
      POLYGON 2.03 3.22 0.18 3.22 0.18 2.89 0.52 2.89 0.52 2.99 1.69 2.99 1.69 2.89 2.03 2.89 ;
  END
END AN211HDX0

