# List of buffers, iverters and delay cells obtained at innovus.log after init_design

#### List of usable buffers: 
# BUHDX1 BUHDX2 BUHDX3 BUHDX4 BUHDX6 BUHDX8
#### List of usable inverters: 
# INHDX1 INHDX2 INHDX3 INHDX4 INHDX6 INHDX8
#### List of identified usable delay cells:  

get_db cts_buffer_cells;
set BUFFERS_CTS "BUHDX1 BUHDX2 BUHDX3 BUHDX4 BUHDX6 BUHDX8"
set_db cts_buffer_cells $BUFFERS_CTS ;# specifies the buffer cells for CTS
get_db cts_buffer_cells;
#
get_db cts_inverter_cells; 
set INVERTERS_CTS "INHDX1 INHDX2 INHDX3 INHDX4 INHDX6 INHDX8"
set_db cts_inverter_cells $INVERTERS_CTS ;# specifies the inverter cells for CTS
get_db cts_inverter_cells;

get_db cts_delay_cells;
set DELAY_CELLS ""
set_db cts_delay_cells $DELAY_CELLS
get_db cts_delay_cells;